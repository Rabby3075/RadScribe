{
  "version": 2,
  "installCommand": "pip install -r requirements-vercel.txt",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/analyze",
      "destination": "/api/analyze.py"
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{data,outputs,notebooks,src,.venv,.vercel,.git}/**"
    }
  }
}
